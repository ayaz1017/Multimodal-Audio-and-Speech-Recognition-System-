# ──────────────────────────────────────
# Application
# ──────────────────────────────────────
APP_NAME=VoiceEmotionAPI
APP_VERSION=1.0.0
DEBUG=true

# ──────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_emotion_db

# ──────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────
# Audio Storage
# ──────────────────────────────────────
AUDIO_STORAGE_PATH=./audio_storage

# ──────────────────────────────────────
# CORS
# ──────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
HF_AUTH_TOKEN=hf_your_huggingface_token_here
